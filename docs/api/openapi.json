{
  "openapi": "3.1.0",
  "info": {
    "title": "Conectados em Cristo API",
    "version": "0.1.0-draft",
    "description": "Contrato inicial proposto. Health check, Problem Details e catálogo público somente leitura estão implementados localmente; as demais operações continuam propostas e devem ser revisadas antes de codificação."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Prefixo relativo; host e ambiente ainda não definidos."
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Identity"
    },
    {
      "name": "Communities"
    },
    {
      "name": "Content"
    },
    {
      "name": "Safety"
    },
    {
      "name": "Prayer"
    },
    {
      "name": "Moderation"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Verifica se o processo está ativo",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Processo ativo."
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Retorna o contexto da conta autenticada",
        "operationId": "getCurrentUser",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Contexto mínimo da conta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/me/profile": {
      "patch": {
        "tags": [
          "Identity"
        ],
        "summary": "Atualiza campos editáveis do próprio perfil",
        "operationId": "patchMyProfile",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/communities": {
      "get": {
        "tags": [
          "Communities"
        ],
        "summary": "Lista metadados de comunidades públicas",
        "operationId": "listPublicCommunities",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "description": "Quantidade máxima de itens; default 20, máximo 50."
          }
        ],
        "responses": {
          "200": {
            "description": "Catálogo público sem posts ou diretório nominal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "description": "Retorna somente comunidades com estado interno active e visibilidade listed. Allowlist pública: id, slug, name, category, description, rulesSummary e joinMode. Não expõe contagens, posts, comentários, membros, solicitações ou status interno. Requer conexão PostgreSQL; sem DATABASE_URL a rota retorna 503, nunca uma lista vazia simulada. Implementado localmente com PostgreSQL; sem banco configurado retorna 503."
      }
    },
    "/communities/{communityId}/posts": {
      "parameters": [
        {
          "name": "communityId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Lista posts visíveis ao membro da comunidade",
        "operationId": "listCommunityPosts",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Posts permitidos pela visibilidade e membership.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Comunidade não encontrada ou não visível."
          }
        }
      },
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "Cria post em comunidade da qual a conta participa",
        "operationId": "createCommunityPost",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePost"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post criado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/posts/{postId}/reactions/support": {
      "parameters": [
        {
          "name": "postId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "tags": [
          "Content"
        ],
        "summary": "Adiciona a reação única Apoiar de forma idempotente",
        "operationId": "addSupportReaction",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reação presente; repetição não duplica.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionState"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Post não encontrado ou não visível."
          }
        }
      },
      "delete": {
        "tags": [
          "Content"
        ],
        "summary": "Remove a própria reação Apoiar",
        "operationId": "removeSupportReaction",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reação removida ou já ausente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionState"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/blocks/{userId}": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "tags": [
          "Safety"
        ],
        "summary": "Cria bloqueio global entre a conta atual e outra conta",
        "operationId": "blockUser",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Bloqueio criado ou já existente."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Conta não encontrada."
          }
        }
      },
      "delete": {
        "tags": [
          "Safety"
        ],
        "summary": "Remove o bloqueio criado pela conta atual",
        "operationId": "unblockUser",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Bloqueio removido ou já ausente."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/reports": {
      "post": {
        "tags": [
          "Safety"
        ],
        "summary": "Registra denúncia sobre conta ou conteúdo",
        "operationId": "createReport",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Denúncia recebida para triagem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportReceipt"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/prayer-requests": {
      "post": {
        "tags": [
          "Prayer"
        ],
        "summary": "Cria pedido de oração privado por padrão",
        "operationId": "createPrayerRequest",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrayerRequestCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido criado com visibilidade definida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrayerRequest"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "description": "Pedidos são privados por padrão. O contrato inicial não permite compartilhamento comunitário; esse fluxo depende de decisão de produto, privacidade e autorização."
      }
    },
    "/me/prayer-requests": {
      "get": {
        "tags": [
          "Prayer"
        ],
        "summary": "Lista somente pedidos de oração próprios",
        "operationId": "listMyPrayerRequests",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pedidos próprios; não inclui pedidos privados de terceiros.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrayerRequestPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/moderation/cases": {
      "get": {
        "tags": [
          "Moderation"
        ],
        "summary": "Lista casos no escopo de moderação autorizado",
        "operationId": "listModerationCases",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Casos limitados às comunidades atribuídas ou escopo administrativo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerationCasePage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/moderation/cases/{caseId}/decisions": {
      "parameters": [
        {
          "name": "caseId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "tags": [
          "Moderation"
        ],
        "summary": "Registra decisão de moderação com motivo",
        "operationId": "decideModerationCase",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModerationDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decisão registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerationCase"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Caso não encontrado ou fora do escopo."
          },
          "409": {
            "description": "Conflito de interesse, estado inválido ou caso já decidido."
          }
        },
        "description": "A API deve aplicar escopo de comunidade, recusa por conflito F-08 e sanções F-03. Sanções globais ficam restritas a administradores; moderadores só atuam em comunidades atribuídas."
      }
    },
    "/communities/{communityId}": {
      "parameters": [
        {
          "name": "communityId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Communities"
        ],
        "summary": "Retorna metadados públicos de uma comunidade listada",
        "description": "Retorna 404 genérico para comunidade inexistente, não listada, pausada ou arquivada. Não concede membership nem acesso a conteúdo. Requer conexão PostgreSQL; sem DATABASE_URL a rota retorna 503. Implementado localmente com PostgreSQL; sem banco configurado retorna 503.",
        "operationId": "getPublicCommunity",
        "responses": {
          "200": {
            "description": "Somente os metadados da allowlist pública.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityPublicMetadata"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session",
        "description": "Nome provisório de contrato; cookie final e CSRF/CORS dependem do provedor de identidade escolhido. Deve ser HttpOnly, Secure e SameSite apropriado."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisição inválida ou malformada; detalhes internos de parser/validação não são retornados.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Sessão ausente ou inválida.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Ação não autorizada para a conta, membership, recurso ou estado.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Falha de validação com mensagem genérica; nunca ecoar valores sensíveis.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso inexistente ou não público; não distingue comunidades privadas/inativas de IDs inexistentes.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Erro interno sem detalhes de implementação.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Catálogo temporariamente indisponível quando a conexão PostgreSQL não está configurada ou acessível.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "requestId"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "Identificador do tipo do problema; about:blank quando não houver tipo específico."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "Descrição segura, sem mensagens internas ou dados da requisição."
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "Somente o caminho; query string não é incluída."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador gerado pelo servidor para correlação."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "restricted",
              "suspended"
            ]
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          },
          "bio": {
            "type": "string",
            "maxLength": 500
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "restricted",
              "private"
            ]
          }
        }
      },
      "ProfilePatch": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "bio": {
            "type": "string",
            "maxLength": 500
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "restricted",
              "private"
            ]
          }
        },
        "additionalProperties": false
      },
      "CommunityPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunityPublicMetadata"
            }
          },
          "nextCursor": {
            "type": "string",
            "maxLength": 512,
            "description": "Cursor opaco de paginação; não é segredo nem autorização."
          }
        }
      },
      "CreatePost": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "additionalProperties": false
      },
      "Post": {
        "type": "object",
        "required": [
          "id",
          "communityId",
          "authorId",
          "body",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "communityId": {
            "type": "string",
            "format": "uuid"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "supportCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PostPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "ReactionState": {
        "type": "object",
        "required": [
          "supported",
          "supportCount"
        ],
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "supportCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ReportCreate": {
        "type": "object",
        "required": [
          "targetType",
          "targetId",
          "reason"
        ],
        "properties": {
          "targetType": {
            "type": "string",
            "enum": [
              "account",
              "post",
              "comment"
            ]
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "fake_profile",
              "scam",
              "harassment",
              "sexual_content",
              "spam",
              "minor_suspected",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      },
      "ReportReceipt": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "received"
            ]
          }
        }
      },
      "PrayerRequestCreate": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private"
            ],
            "default": "private"
          }
        },
        "additionalProperties": false
      },
      "PrayerRequest": {
        "type": "object",
        "required": [
          "id",
          "body",
          "visibility",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PrayerRequestPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrayerRequest"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "ModerationDecision": {
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "guidance",
              "warning",
              "hide_content",
              "restrict",
              "suspend",
              "ban"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "durationHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          }
        },
        "additionalProperties": false
      },
      "ModerationCase": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "reviewing",
              "decided",
              "appealed",
              "closed"
            ]
          },
          "communityId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ModerationCasePage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModerationCase"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "CommunityPublicMetadata": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "category",
          "description",
          "rulesSummary",
          "joinMode"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador estável; não é credencial."
          },
          "slug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Rótulo curado pela administração; taxonomia ainda não fixada."
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "rulesSummary": {
            "type": "string",
            "maxLength": 1200
          },
          "joinMode": {
            "type": "string",
            "enum": [
              "open",
              "approval"
            ],
            "description": "Informativo; não concede entrada sem autenticação e autorização."
          }
        }
      }
    }
  }
}
