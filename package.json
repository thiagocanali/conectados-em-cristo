{
  "name": "conectados-em-cristo",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://thiagocanali.github.io/conectados-em-cristo",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.vue",
    "test": "node --test tests/*.test.mjs",
    "deploy": "gh-pages -d dist",
    "api:dev": "tsx watch server/src/server.mts",
    "api:start": "node server/dist/server.mjs",
    "api:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "api:test": "node --import=tsx --test server/tests/*.test.mts",
    "api:build": "tsc -p server/tsconfig.build.json",
    "api:check": "npm run api:typecheck && npm run api:test && npm run api:build",
    "api:migrate": "tsx server/src/db/migrate.mts",
    "api:db:test": "node --import=tsx --test server/tests/*.db.mts"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "fastify": "^5.12.8",
    "pinia": "^3.0.4",
    "vue": "^3.2.13",
    "vue-router": "^4.6.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "@types/pg": "^8.15.6"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": "^22 || ^24 || ^26"
  }
}
