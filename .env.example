# Server only. Keep actual credentials in .env.local or Vercel Secrets.
DATABASE_URL=
# Direct Neon PostgreSQL URL for schema migrations only (never expose to browser).
# The runtime DATABASE_URL may point to Neon's transaction pooler.
DATABASE_URL_UNPOOLED=
# Optional PEM CA for verified TLS. When set, omit SSL query parameters from DATABASE_URL.
# Store the full multiline PEM certificate in Vercel; never disable certificate verification.
DATABASE_SSL_CA=
